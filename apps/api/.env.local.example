# Anthropic API Key
# Get this from: https://console.anthropic.com/settings/keys
# Never commit your actual .env.local — add it to .gitignore
ANTHROPIC_API_KEY=sk-ant-...

# App Environment
NODE_ENV=development

# Shared app token — the mobile app must send this in the `x-app-token` header
# or the /api/analyze endpoint returns 401. Protects the public endpoint from
# abuse that would bill your Anthropic account. Must MATCH the mobile build's
# APP_TOKEN. Generate one with: openssl rand -hex 32
# If unset, the endpoint fails OPEN (no protection) — set it in Vercel.
APP_SHARED_TOKEN=

# === Rate limiting / spend control (Upstash Redis) ===
# Durable, cross-instance counters for /api/analyze. Without these the limiter
# silently falls back to per-instance memory: bursts are still capped, but the
# daily and global spend ceilings are INACTIVE.
#
# Provision "Upstash for Redis" from the Vercel Marketplace and it will inject
# KV_REST_API_URL / KV_REST_API_TOKEN automatically — either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning — all have sane defaults, all changeable in Vercel without a
# deploy. RATE_LIMIT_GLOBAL_DAILY_MAX is the real spend ceiling: once the whole
# service passes it in a UTC day, /api/analyze returns 503 until midnight.
# RATE_LIMIT_BURST_MAX=20            # per IP per 10 minutes
# RATE_LIMIT_IP_DAILY_MAX=50         # per IP per UTC day
# RATE_LIMIT_GLOBAL_DAILY_MAX=2000   # all callers per UTC day (circuit breaker)

# === V1 (Supabase — not needed for V0) ===
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
