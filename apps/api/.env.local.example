# Anthropic API Key
# Get this from: https://console.anthropic.com/settings/keys
# Never commit your actual .env.local — add it to .gitignore
ANTHROPIC_API_KEY=sk-ant-...

# App Environment
NODE_ENV=development

# Shared app token — the mobile app must send this in the `x-app-token` header
# or the /api/analyze endpoint returns 401. Protects the public endpoint from
# abuse that would bill your Anthropic account. Must MATCH the mobile build's
# APP_TOKEN. Generate one with: openssl rand -hex 32
# If unset, the endpoint fails OPEN (no protection) — set it in Vercel.
APP_SHARED_TOKEN=

# === Supabase (accounts, the $200/day spend cap, per-IP limits) ===
# The SECRET key — server only, never in the app. Without these, account
# deletion returns 503 and only the in-memory burst limit applies: the per-IP
# daily limit and the spend cap are INACTIVE. See ACCOUNTS-SETUP.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Sign in with Apple token revocation on account deletion (ACCOUNTS-SETUP.md §3).
# APPLE_TEAM_ID=
# APPLE_SIGN_IN_KEY_ID=
# APPLE_SIGN_IN_PRIVATE_KEY=   # the .p8 contents
# APPLE_CLIENT_ID=com.eatoutbetter.app

# Optional tuning — all have sane defaults, all changeable in Vercel without a
# code change. SPEND_GLOBAL_DAILY_USD is the real ceiling: once a UTC day's
# Claude spend reaches it, /api/analyze returns 503 until midnight.
# SPEND_GLOBAL_DAILY_USD=200         # dollars per UTC day
# RATE_LIMIT_BURST_MAX=20            # per IP per 10 minutes
# RATE_LIMIT_IP_DAILY_MAX=50         # per IP per UTC day
# RATE_LIMIT_GLOBAL_DAILY_MAX=10000  # request backstop, in case spend recording breaks
# RATE_LIMIT_IP_SALT=                # defaults to SUPABASE_SECRET_KEY
